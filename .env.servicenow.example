# Credentials can be instance-scoped or generic. Instance-scoped keys win;
# generic SN_* keys are used as a fallback. Values are read without modifying
# process.env or this file.

# Generic fallback (basic or oauth2)
SN_AUTH_TYPE=basic

# ----- BASIC AUTHENTICATION -----
# Required for basic auth, and for the OAuth password grant
SN_USERNAME=admin
SN_PASSWORD=admin_password

# ----- OAUTH 2.0 AUTHENTICATION -----
# Supported grants: password, client_credentials, authorization_code
SN_GRANT_TYPE=password
SN_CLIENT_ID=your-client-id
SN_CLIENT_SECRET=your-client-secret

# Instance-specific credentials override the generic fallback, for example:
# DEV21345_SN_AUTH_TYPE=oauth2
# DEV21345_SN_GRANT_TYPE=client_credentials
# DEV21345_SN_CLIENT_ID=your-client-id
# DEV21345_SN_CLIENT_SECRET=your-client-secret
# COMPANYDEV_SN_AUTH_TYPE=basic
# COMPANYDEV_SN_USERNAME=your-username
# COMPANYDEV_SN_PASSWORD=your-password

# For authorization_code, provide SN_REFRESH_TOKEN (or SN_AUTHORIZATION_CODE).