SN_INSTANCE=your-instance-name

# Authentication Type: 'basic' or 'oauth2'
SN_AUTH_TYPE=basic

# ----- BASIC AUTHENTICATION -----
# Required if SN_AUTH_TYPE=basic (also required for oauth2 "password" grant)
SN_USERNAME=admin
SN_PASSWORD=admin_password

# ----- OAUTH 2.0 AUTHENTICATION -----
# Required if SN_AUTH_TYPE=oauth2
# Supported grant types: 'password', 'client_credentials', 'jwt-bearer'
SN_GRANT_TYPE=password
SN_CLIENT_ID=your-client-id
SN_CLIENT_SECRET=your-client-secret

# Required only if SN_GRANT_TYPE=jwt-bearer
SN_JWT_ASSERTION=your-jwt-assertion